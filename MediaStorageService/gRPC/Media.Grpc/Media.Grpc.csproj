<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e8dda1f1-cd8a-4322-b23d-5d28c421edcc</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
  </PropertyGroup>


    <ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.30.0" />
		<PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
		<PackageReference Include="Grpc.Tools" Version="2.57.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>


    <ItemGroup>
      <ProjectReference Include="..\..\Core\Media.ServiceAbstruction\Media.ServiceAbstraction.csproj" />
      <ProjectReference Include="..\..\Core\Media.Service\Media.Service.csproj" />
      <ProjectReference Include="..\..\Infrastructure\Media.Settings\Media.Settings.csproj" />
    </ItemGroup>
	<ItemGroup>
		<Protobuf Include="Protos\media.proto" GrpcServices="Server" />
	</ItemGroup>

</Project>
